# Copiá estos valores en Vercel → Settings → Environment Variables

# Usuario administrador (puede registrar e importar)
AUTH_USER=tu_usuario
AUTH_PASSWORD=una_contraseña_larga_y_segura
AUTH_TOKEN=pega_aqui_un_token_secreto_aleatorio_admin

# Usuario solo lectura (puede ver reportes y exportar CSV)
READONLY_USER=lector
READONLY_PASSWORD=otra_contraseña_segura
READONLY_TOKEN=pega_aqui_otro_token_secreto_aleatorio
